 # canonical slice metadata and the Info.plist writer used by both scripts so
 # the manifest is produced from a single place.
 
+# Deletes build directories tolerantly. Xcode 27's background indexer can keep
+# writing into these paths while the build phase cleans them, causing a plain
+# `rm -rf` to fail with ENOTEMPTY under `set -e`. Renaming first atomically
+# detaches the live path; deletion of the detached directory may then race
+# harmlessly with the indexer.
+safe_remove_dirs() {
+  local dir
+  for dir in "$@"; do
+    [[ -e "$dir" ]] || continue
+    local trash="${dir}.trash.$$"
+    if mv "$dir" "$trash" 2>/dev/null; then
+      rm -rf "$trash" 2>/dev/null || true
+    else
+      rm -rf "$dir" 2>/dev/null || true
+    fi
+  done
+}
