{
  "cli": {
    "version": ">= 16.26.0",
    "appVersionSource": "local"
  },
  "build": {
    "development-client": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },

    "release-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },

    "release-aab": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    },

    "release-ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}
